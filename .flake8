# Configuration file for flake8, a Python linting tool

[flake8]
# Maximum allowed line length for code
max-line-length = 120

# List of error codes to ignore during linting
# D203: One blank line required before class docstring
# E203: Whitespace before ':' (ignored due to black compatibility)
# W503: Line break occurred before a binary operator (ignored due to black compatibility)
# E704: Multiple statements on one line (def)
# H403: Multi-line docstrings should end on a new line
# H405: Multi-line docstring summary not separated with an empty line
# E501: Line too long (handled by max-line-length)
# F401: Module imported but unused
# E221: Multiple spaces before operator
# E241: Multiple spaces after ','
ignore = D203,E203,W503,E704,H403,H405,E501,F401,E221,E241,E741

# Directories and files to exclude from linting
exclude =
    .git,
    __pycache__,
    venv,
    env,
    assets,
    environment,

# Specific files with custom ignore rules
per-file-ignores =
    __init__.py: F401

# Maximum allowed cyclomatic complexity for functions
max-complexity = 25